{
  "$comment": "Slim, fast config for the headless top-gainer decision session. No hooks, no audio, no extra skills/MCP — minimal context so each claude -p call is fast. Only the trading tools are allowed.",
  "disableAllHooks": true,
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(venv/bin/python topgainer/exec_trade.py:*)",
      "Bash(venv/bin/python topgainer/state.py:*)",
      "Bash(venv/bin/python topgainer/price.py:*)",
      "Read(//Users/yuniorrodriguezosorio/Documents/GitHub/ib-trader/data/topgainer/**)",
      "Read(//Users/yuniorrodriguezosorio/Documents/GitHub/ib-trader/topgainer/**)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(git push:*)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "enableAllProjectMcpServers": false
}
