<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ibtrader.printpostmarket</string>
  <!-- 16:25 ET, despues de com.ibtrader.polychains (16:20) que archiva la cadena del cierre
       (Yunior 2026-07-30: "after market print updated plan for glw, nbis, be as well plus tree
       forecast, same for microsoft"). Festivos: portero de dia de mercado del runner (flag market-day). -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string><string>-lc</string>
    <string>cd "$HOME/ib-trader" &amp;&amp; ./scripts/print_postmarket_plans.sh &gt;&gt; logs/print_postmarket.log 2&gt;&amp;1</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>25</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>25</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>25</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>25</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>25</integer></dict>
  </array>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/tmp/ibtrader.printpostmarket.out</string>
  <key>StandardErrorPath</key><string>/tmp/ibtrader.printpostmarket.err</string>
</dict>
</plist>
