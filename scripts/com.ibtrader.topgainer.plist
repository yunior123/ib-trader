<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Top-gainer system supervisor ("working non stop", Yunior 2026-07-10).
     Runs ensure_all.sh at login AND every 2 minutes: starts any DEAD component
     (watchdog keepalive / alert bot / Claude loop / heartbeat) and touches
     nothing alive — so the stack survives reboots AND mid-day crashes without
     ever bouncing a healthy Claude decision cycle. LIVE orders enabled here
     (TOPGAINER_LIVE=1) — the interlock file data/topgainer/armed is still
     required, so `rm data/topgainer/armed` fully disarms even with this loaded.
     For a manual full clean restart use start_all.sh (pkill+relaunch).
     Install: cp scripts/com.ibtrader.topgainer.plist ~/Library/LaunchAgents/
              launchctl load ~/Library/LaunchAgents/com.ibtrader.topgainer.plist -->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.ibtrader.topgainer</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>export TOPGAINER_LIVE=1; exec /bin/zsh /Users/yuniorrodriguezosorio/Documents/GitHub/ib-trader/topgainer/ensure_all.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/yuniorrodriguezosorio/Documents/GitHub/ib-trader</string>
    <key>RunAtLoad</key><true/>
    <key>StartInterval</key><integer>120</integer>
    <key>AbandonProcessGroup</key><true/>
    <key>StandardOutPath</key>
    <string>/Users/yuniorrodriguezosorio/Documents/GitHub/ib-trader/topgainer/autostart.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/yuniorrodriguezosorio/Documents/GitHub/ib-trader/topgainer/autostart.err</string>
</dict>
</plist>
