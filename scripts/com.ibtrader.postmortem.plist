<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ibtrader.postmortem</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/yuniorrodriguezosorio/ib-trader/venv/bin/python</string>
        <string>/Users/yuniorrodriguezosorio/ib-trader/scripts/x_postmortem.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/yuniorrodriguezosorio/ib-trader</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>16</integer>
        <key>Minute</key>
        <integer>20</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <!-- OJO: log separado del x_postmortem.log del script — el ledger cuenta
         " POSTED " por linea y un stdout duplicado inflaria el conteo -->
    <key>StandardOutPath</key>
    <string>/Users/yuniorrodriguezosorio/ib-trader/x_postmortem_launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/yuniorrodriguezosorio/ib-trader/x_postmortem_launchd.log</string>
</dict>
</plist>
