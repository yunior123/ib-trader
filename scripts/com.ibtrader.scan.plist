<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Localhost real-time ticker scanner (Yunior 2026-07-10): scan_server (C++)
     on http://localhost:8765 — type any ticker, see live bid/ask + tape.
     KeepAlive restarts it if it dies; RunAtLoad starts it at login.
     Install: cp scripts/com.ibtrader.scan.plist ~/Library/LaunchAgents/
              launchctl load ~/Library/LaunchAgents/com.ibtrader.scan.plist -->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.ibtrader.scan</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/yuniorrodriguezosorio/ib-trader/scan_server</string>
        <string>NVDA</string>
        <string>8765</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/yuniorrodriguezosorio/ib-trader</string>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key>
    <string>/Users/yuniorrodriguezosorio/ib-trader/scan_server.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/yuniorrodriguezosorio/ib-trader/scan_server.err</string>
</dict>
</plist>
