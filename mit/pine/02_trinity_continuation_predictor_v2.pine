//@version=6
indicator("Trinity Continuation Predictor v2 — Public Logic Reconstruction", overlay = true, max_labels_count = 500)

// Independent CONTINUATION detector.
// Publicly visible components: price vs EMA5 on 5/15/60/240/D, a 20-period
// High/HLC3/Low ribbon, RSI-Bollinger state, DMI/ADX direction, and ATR energy.
// The original author's undisclosed signal generator cannot be replicated exactly.

string tz = input.string("America/New_York", "Session timezone")
string rth = input.session("0930-1600", "Regular session")
int alignmentLength = input.int(5, "MTF EMA length", minval = 1)
int ribbonLength = input.int(20, "High/HLC3/Low ribbon length", minval = 2)
int rsiLength = input.int(14, "RSI length", minval = 2)
int rsiBBLength = input.int(20, "RSI Bollinger length", minval = 2)
float rsiBBDeviation = input.float(2.0, "RSI Bollinger deviations", step = 0.1)
int diLength = input.int(14, "DI length", minval = 2)
int adxSmoothing = input.int(14, "ADX smoothing", minval = 2)
float adxFloor = input.float(20.0, "ADX floor")
bool requireAdxRising = input.bool(true, "Require ADX rising over 2 bars")
bool requireEnergy = input.bool(true, "Require ATR energy")
float energyRatio = input.float(0.14, "5m ATR / previous daily ATR", step = 0.01)
bool useConfirmedHTF = input.bool(false, "Use only completed HTF EMA values (slower, non-developing)")
bool dynamicWebhookAlerts = input.bool(true, "Send dynamic alert() JSON")

bool inSession = not na(time(timeframe.period, rth, tz))
bool isFiveMinute = timeframe.isminutes and timeframe.multiplier == 5

f_mtf_ema(string tf) =>
    useConfirmedHTF ? request.security(syminfo.tickerid, tf, ta.ema(close, alignmentLength)[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on) : request.security(syminfo.tickerid, tf, ta.ema(close, alignmentLength), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

float ema5m = ta.ema(close, alignmentLength)
float ema15m = f_mtf_ema("15")
float ema60m = f_mtf_ema("60")
float ema240m = f_mtf_ema("240")
float emaDaily = f_mtf_ema("D")

int bullAlignment = (close > ema5m ? 1 : 0) + (close > ema15m ? 1 : 0) + (close > ema60m ? 1 : 0) + (close > ema240m ? 1 : 0) + (close > emaDaily ? 1 : 0)
int bearAlignment = (close < ema5m ? 1 : 0) + (close < ema15m ? 1 : 0) + (close < ema60m ? 1 : 0) + (close < ema240m ? 1 : 0) + (close < emaDaily ? 1 : 0)
bool mtfBull = bullAlignment == 5
bool mtfBear = bearAlignment == 5

float ribbonHigh = ta.ema(high, ribbonLength)
float ribbonMid = ta.ema(hlc3, ribbonLength)
float ribbonLow = ta.ema(low, ribbonLength)
float rsi = ta.rsi(close, rsiLength)
float rsiBasis = ta.sma(rsi, rsiBBLength)
float rsiDeviation = rsiBBDeviation * ta.stdev(rsi, rsiBBLength)
float rsiUpper = rsiBasis + rsiDeviation
float rsiLower = rsiBasis - rsiDeviation
[plusDI, minusDI, adx] = ta.dmi(diLength, adxSmoothing)
float adxSlope = adx - adx[2]
float atr5m = ta.atr(14)
float previousDailyAtr = request.security(syminfo.tickerid, "D", ta.atr(14)[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float currentEnergyRatio = previousDailyAtr > 0 ? atr5m / previousDailyAtr : 0
bool energyPass = not requireEnergy or currentEnergyRatio >= energyRatio
bool adxSlopePass = not requireAdxRising or adxSlope > 0

bool bullishRsiFlow = rsi > rsiBasis and rsi > 50
bool bearishRsiFlow = rsi < rsiBasis and rsi < 50
bool continuationUp = inSession and mtfBull and close > ribbonHigh and bullishRsiFlow and plusDI > minusDI and adx >= adxFloor and adxSlopePass and energyPass
bool continuationDown = inSession and mtfBear and close < ribbonLow and bearishRsiFlow and minusDI > plusDI and adx >= adxFloor and adxSlopePass and energyPass
bool upPulse = continuationUp and not continuationUp[1]
bool downPulse = continuationDown and not continuationDown[1]

pHigh = plot(ribbonHigh, "Ribbon high", color = color.new(color.blue, 12))
plot(ribbonMid, "Ribbon HLC3", color = color.new(color.blue, 38))
pLow = plot(ribbonLow, "Ribbon low", color = color.new(color.blue, 12))
fill(pHigh, pLow, color = color.new(color.blue, 88))

barcolor(continuationUp ? color.new(color.lime, 72) : continuationDown ? color.new(color.red, 72) : na)
plotshape(upPulse, "Continuation up pulse", shape.triangleup, location.belowbar, color.aqua, size = size.small, text = "CONT")
plotshape(downPulse, "Continuation down pulse", shape.triangledown, location.abovebar, color.fuchsia, size = size.small, text = "CONT")

alertcondition(upPulse, "Trinity continuation predicted up", "Trinity continuation state turned UP.")
alertcondition(downPulse, "Trinity continuation predicted down", "Trinity continuation state turned DOWN.")
if dynamicWebhookAlerts and upPulse
    alert('{"indicator":"trinity_v2","symbol":"' + syminfo.ticker + '","direction":"up","alignment":5,"adx":' + str.tostring(adx, "#.##") + ',"energy":' + str.tostring(currentEnergyRatio, "#.###") + '}', alert.freq_once_per_bar_close)
if dynamicWebhookAlerts and downPulse
    alert('{"indicator":"trinity_v2","symbol":"' + syminfo.ticker + '","direction":"down","alignment":5,"adx":' + str.tostring(adx, "#.##") + ',"energy":' + str.tostring(currentEnergyRatio, "#.###") + '}', alert.freq_once_per_bar_close)

var table dashboard = table.new(position.top_right, 2, 9, border_width = 1)
if barstate.islast
    table.cell(dashboard, 0, 0, "TRINITY v2")
    table.cell(dashboard, 1, 0, isFiveMinute ? "5m READY" : "USE 5m", bgcolor = isFiveMinute ? color.new(color.green, 75) : color.new(color.red, 70))
    table.cell(dashboard, 0, 1, "MTF alignment")
    table.cell(dashboard, 1, 1, mtfBull ? "5/5 BULL" : mtfBear ? "5/5 BEAR" : str.tostring(math.max(bullAlignment, bearAlignment)) + "/5 MIXED")
    table.cell(dashboard, 0, 2, "Ribbon")
    table.cell(dashboard, 1, 2, close > ribbonHigh ? "ABOVE" : close < ribbonLow ? "BELOW" : "INSIDE")
    table.cell(dashboard, 0, 3, "RSI / basis")
    table.cell(dashboard, 1, 3, str.tostring(rsi, "#.0") + " / " + str.tostring(rsiBasis, "#.0"))
    table.cell(dashboard, 0, 4, "RSI BB state")
    table.cell(dashboard, 1, 4, rsi > rsiUpper ? "UPPER EXPANSION" : rsi < rsiLower ? "LOWER EXPANSION" : rsi > rsiBasis ? "BULL FLOW" : "BEAR FLOW")
    table.cell(dashboard, 0, 5, "+DI / -DI")
    table.cell(dashboard, 1, 5, str.tostring(plusDI, "#.0") + " / " + str.tostring(minusDI, "#.0"))
    table.cell(dashboard, 0, 6, "ADX / slope")
    table.cell(dashboard, 1, 6, str.tostring(adx, "#.0") + " / " + str.tostring(adxSlope, "+#.0;-#.0"))
    table.cell(dashboard, 0, 7, "ATR energy")
    table.cell(dashboard, 1, 7, str.tostring(currentEnergyRatio, "#.000") + (energyPass ? " PASS" : " FAIL"))
    table.cell(dashboard, 0, 8, "Output")
    table.cell(dashboard, 1, 8, continuationUp ? "CONTINUE UP" : continuationDown ? "CONTINUE DOWN" : "NO FULL ALIGNMENT")
