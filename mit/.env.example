# Start with mock mode. It needs no API keys.
MIT_MODE=mock
MIT_HOST=0.0.0.0
MIT_PORT=8000
MIT_REFRESH_SECONDS=5
MIT_WATCHLIST=SPY,QQQ,IWM,TSLA,MSTR,NVDA,AAPL,VIX

# Capability routing: mock | databento | intrinio | unusual_whales
MIT_MARKET_PROVIDER=mock
MIT_OPTIONS_PROVIDER=mock
MIT_DEPTH_PROVIDER=mock
MIT_FLOW_PROVIDER=mock

# Shock / reversion-watch settings. These are alerts, not reversal guarantees.
MIT_SHOCK_PCT=10
MIT_EXTREME_SHOCK_PCT=15
MIT_SHOCK_ZSCORE=2.5
MIT_REVERSION_LOOKBACK_DAYS=756
MIT_REVERSAL_HORIZON_DAYS=2

# Databento
DATABENTO_API_KEY=
MIT_DATABENTO_MARKET_DATASET=EQUS.MINI
MIT_DATABENTO_DEPTH_DATASET=XNAS.ITCH
MIT_DATABENTO_OPTIONS_DATASET=OPRA.PILLAR
MIT_DATABENTO_DEPTH_SCHEMA=mbp-10
MIT_DATABENTO_USE_LIVE=false
MIT_DATABENTO_LIVE_WARMUP_SECONDS=1.5

# Intrinio
INTRINIO_API_KEY=
MIT_INTRINIO_BASE_URL=https://api-v2.intrinio.com
MIT_INTRINIO_STOCK_SOURCE=iex
MIT_INTRINIO_OPTIONS_SOURCE=delayed

# Unusual Whales. Supply values exactly as documented for your account.
UNUSUAL_WHALES_TOKEN=
MIT_UW_WS_URL=
MIT_UW_TOPICS=flow-alerts,live-gex,option-state,greek-flow
# JSON templates may use {token}, {symbol}, and {topics} placeholders.
MIT_UW_AUTH_MESSAGE_JSON={"type":"auth","token":"{token}"}
MIT_UW_SUBSCRIBE_MESSAGE_JSON={"type":"subscribe","topics":{topics},"symbol":"{symbol}"}
